# 이 파일을 config.toml 로 복사한 뒤 값을 채워주세요.
# 주의: config.toml 은 절대 git 에 커밋하지 마세요 (.gitignore 등록 필수)

# ── 키움 API 키 ────────────────────────────────────────────────
# 모의/실전은 키가 별도 발급이므로 섹션이 나뉩니다.
# UI 의 모드 전환이 해당 섹션 키로 재연결하며, DB 파일도 모드별로 분리됩니다.
# (기존 평면 [kiwoom] appkey/secretkey 형식도 모의투자 키로 호환 인식됩니다)

[kiwoom.mock]
appkey = "모의투자 앱키"
secretkey = "모의투자 시크릿키"
account = ""      # 화면 표시용 (예: "5790-8081 위탁종합") — 키에 계좌가 묶여 있어 표기만 하면 됨

[kiwoom.real]
appkey = ""       # 실전 전환 시 실전용 키 기입
secretkey = ""
account = ""

# ── Discord 봇 (알림 + 명령 + 대시보드) ────────────────────────
# 알림 발송·슬래시 명령·장중 대시보드가 모두 이 봇 하나로 나간다.
# 설정을 비워두면 Discord 없이 프로그램만 동작한다(화면 로그·DB 기록은 그대로).
#
# 봇 준비 절차:
#   1. https://discord.com/developers/applications → New Application
#   2. Bot 탭 → Reset Token 으로 토큰 발급 (Public Bot 은 꺼둘 것)
#   3. OAuth2 → URL Generator → scopes: bot, applications.commands
#      권한: View Channels, Send Messages, Embed Links, Attach Files,
#            Read Message History, Manage Messages(대시보드 고정용)
#   4. Discord 설정 → 고급 → 개발자 모드 켜기 → 채널·본인 우클릭으로 ID 복사
#
# allowed_users 를 비워두면 봇이 아예 켜지지 않는다(아무나 조작하는 것을 막기 위해).
[discord]
bot_token = ""     # 개발자 포털에서 발급한 봇 토큰 — 유출 시 Reset Token 으로 무효화
channel_id = ""    # 봇이 사용할 채널 ID (숫자)
allowed_users = [] # 명령을 쓸 수 있는 사용자 ID 목록 (예: ["123456789012345678"])

# ── 거래비용 (세후 실현손익 계산에 사용) ───────────────────────
# commission_rate: 증권사 수수료율. 계좌·이벤트마다 다르므로 영웅문의
#   [키움 홈 → 고객서비스 → 수수료 안내] 또는 계좌 개설 안내에서 실제 요율을 확인하세요.
#   예) 0.015% → 0.00015,  0.0036396% → 0.000036396
# tax_rate: 증권거래세율(농특세 포함). 매도에만 부과되며 제도 변경이 잦으니
#   한국거래소·국세청 공지 또는 영웅문 거래내역의 실제 차감액으로 확인해 맞추세요.
#   코스피/코스닥이 다를 수 있으므로 주로 매매하는 시장 기준으로 넣습니다.
[fees]
commission_rate = 0.00015
tax_rate = 0.0015

# ── 복기 차트 ──────────────────────────────────────────────────
# font: 차트 한글 폰트 이름. 비우면 맑은 고딕 → 나눔고딕 → Noto Sans KR 순으로 자동 선택.
#   다른 폰트를 쓰려면 Windows 에 설치 후 이름을 적는다 (예: "Pretendard", "NanumGothic")
[chart]
font = ""

# ── 시작 시 자동 연결 ──────────────────────────────────────────
# true 면 프로그램을 켤 때 키움·Discord 를 스스로 연결한다(버튼을 누를 필요가 없다).
# 연결은 조회·알림 경로만 여는 것이라 **그 자체로는 주문이 나가지 않는다** —
# 실제 매매는 '감시 시작' 이후에만 일어난다.
# 실패하면 5분마다 다시 시도하므로 증권사 서버 점검 중에 켜도 복구되면 자동으로 붙는다.
[startup]
auto_connect = false

# ── 자동 스케줄 (무인 운용) ────────────────────────────────────
# enabled = true 로 두면 평일에 자동으로 연결 → 감시 시작 → 마감 시 중지 → 요약 발송.
# 휴장일에는 체결 틱이 없어 감시가 켜져도 아무 일도 일어나지 않습니다.
# 화면의 매매일이 '오늘'이 아니면 자동 시작을 건너뜁니다(지난 리스트 매매 방지).
[schedule]
enabled = false
start = "08:55"    # 감시 자동 시작
stop = "15:30"     # 감시 자동 중지
summary = "15:35"  # 일일 요약 Discord 발송
summary2 = "20:05"  # 시간외(NXT) 거래가 있던 종목의 3분봉 재전송
